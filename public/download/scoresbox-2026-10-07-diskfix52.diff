+    sleep 20
+    TAG="$TAG" DEPLOY_IMAGE="$DEPLOY_IMAGE" POSTGRES_PASSWORD="$POSTGRES_PASSWORD" \
+      docker compose -f "$COMPOSE_FILE" pull
+  fi
 fi
