# ============================================================
# SCORESBOX · .env.example — шаблон конфигурации окружения
# Скопируйте в .env и заполните значения: cp .env.example .env
# Никогда не коммитьте .env в git — там секреты.
# Текущий домен — scoresbox.ru (временный). Смена домена —
# раздел «Смена домена» в DEPLOY.md (меняются SITE_URL + nginx + cert).
# ============================================================

# --- База данных (PostgreSQL) ---
# В docker-compose адрес БД подставляется автоматически (db:5432).
# Эта переменная нужна только для запуска БЕЗ докера (локальная разработка):
# DATABASE_URL=postgresql://scoresbox:scoresbox@localhost:5432/scoresbox?schema=public

# Пароль postgres (прод: подставляется в compose при старте БД и в DATABASE_URL)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Безопасность ---
# Секрет для подписи HMAC-cookie сессий. Сгенерируйте: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_RANDOM_HEX

# --- Первый администратор (используется один раз при первом деплое) ---
# Email — это просто логин: при смене домена менять не обязательно.
ADMIN_EMAIL=admin@scoresbox.ru
# Минимум 8 символов; после первого входа смените и включите 2FA
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Сайт ---
# Публичный URL (sitemap, canonical, robots.txt, cookies) — главный «доменный»
# переключатель: при смене домена правьте ЗДЕСЬ + см. DEPLOY.md → Смена домена
SITE_URL=https://scoresbox.ru

# Показывать демо-аккаунты на странице входа (1 = да, 0 = нет)
SHOW_DEMO_ACCOUNTS=0

# --- Почта: приглашения и сбросы пароля (v1.0.33) ---
# ЗОЛОТОЙ СТАНДАРТ: одноразовая ссылка уходит ПИСЬМОМ на email
# пользователя — клик по письму подтверждает владение ящиком, админ
# ссылку не видит. Пока SMTP_HOST не задан, сайт работает в ручном
# режиме: ссылка показывается админу для передачи лично, получатель
# подтверждает адрес при установке пароля.
# Пример для Яндекс 365 / Mail.ru:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=no-reply@scoresbox.ru
#   SMTP_PASS=пароль-приложения
#   MAIL_FROM="SCORESBOX <no-reply@scoresbox.ru>"
# 587 без SMTP_SECURE (STARTTLS) — для большинства корпоративных релеев.
# Порт 465 требует SMTP_SECURE=true. Подробности: ADMIN-GUIDE.md
# «Почта и приглашения».
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#MAIL_FROM=
