// PRD: Спортивно-аналитический портал "Футбол Чувашии"
// Модель данных v1.0 — PostgreSQL (золотой стандарт: и дев, и CI, и прод на одном движке БД)
// Инвариант №1: жёсткое разделение Person (человек) / Team (команда-состав) / Club (бренд/юрлицо)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Milestone 1: Core & Identity
// ============================================================

/// Физическое лицо. Может быть игроком, тренером И судьёй одновременно (в разных лигах)
model Person {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  middleName String?
  birthDate  DateTime?
  /// MALE | FEMALE
  gender     String?
  /// GK | DF | MF | FW — игровая позиция (только для роли PLAYER)
  position   String?
  /// Специализации: коды из lib/roles.ts (PLAYER, COACH, REFEREE, …) + кастомные «c:<id>»
  roles      String[]  @default([])
  /// Дубликат старого флага; синхронизируется с roles (REFEREE) — для фильтров судей и публичной страницы
  isReferee  Boolean   @default(false)
  /// Фото персоны: /api/media/<id> (таблица Media)
  photoUrl   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  users             User[]
  registrations     Registration[]
  events            MatchEvent[]       @relation("EventPerson")
  assists           MatchEvent[]       @relation("EventAssist")
  lineups           LineupEntry[]
  suspensions       Suspension[]
  refereedMatches   Match[]            @relation("MatchReferee")
  ratingsReceived  RefereeRating[]    @relation("RatingReferee")
  officialRoles     MatchOfficial[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// SUPER_ADMIN | LEAGUE_ADMIN | CLUB_ADMIN | REFEREE | PLAYER
  role         String
  /// Заблокирован ли вход (управляет SUPER_ADMIN в панели «Пользователи»)
  isActive     Boolean  @default(true)
  /// Версия сессий (v1.0.23): инкремент при сбросе пароля/2FA — мгновенно
  /// убивает все выданные cookie (сравнение в getSessionUser, см. auth.ts)
  sessionVersion Int    @default(0)
  personId     String?
  person       Person?  @relation(fields: [personId], references: [id])
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id])
  /// v1.0.32: скоуп лиги для LEAGUE_ADMIN — админ КОНКРЕТНОЙ лиги видит и
  /// правит только её (турниры/матчи/протоколы/заявки/КДК). NULL = без
  /// ограничений (оператор всего сайта). См. lib/scope.ts и ADMIN-GUIDE.md
  leagueId     String?
  league       League? @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  ratingsGiven RefereeRating[] @relation("RatingAuthor")

  /// v1.0.33: почта подтверждена. true — ссылку из письма/приглашения
  /// открыл владелец ящика (SMTP-режим) либо пользователь явно подтвердил
  /// почту при установке пароля (ручная доставка ссылок). false — адрес
  /// мог быть введён с опечаткой: в панели горит бейдж, сбросы идут туда же.
  emailVerified Boolean @default(false)
  /// v1.0.33: пользователь УСТАНОВИЛ пароль по одноразовой ссылке.
  /// false = приглашение ещё не принято (вход невозможен — хэш-заглушка).
  /// До true кнопка «Приглашение» выдаёт invite-ссылку (48 ч), после —
  /// pwset-ссылку сброса (15 мин).
  passwordSet   Boolean @default(false)

  /// 2FA (RFC 6238 TOTP): секрет в base32, включён/выключен
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  /// последний принятый TOTP-шаг (30 c) — защита от повтора кода
  totpLastStep Int      @default(0)
  /// резервные коды (sha256-хэши, JSON-массив) для входа без телефона
  recoveryCodes String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([personId])
  @@index([clubId])
  @@index([leagueId])
}

model Club {
  id          String  @id @default(cuid())
  name        String
  city        String?
  logoUrl     String?
  description String?
  teams       Team[]
  admins      User[]
}

model Team {
  id      String  @id @default(cuid())
  name    String
  clubId  String?
  club    Club?   @relation(fields: [clubId], references: [id])
  logoUrl String?
  city    String?
  registrations Registration[]
  homeMatches Match[]      @relation("HomeTeam")
  awayMatches Match[]      @relation("AwayTeam")
  events      MatchEvent[]
  lineups     LineupEntry[]
}

model Stadium {
  id       String @id @default(cuid())
  name     String
  city     String?
  address  String?
  capacity Int?
  /// Фото арены: /api/media/<id>
  photoUrl String?
  matches  Match[]
}

/// Кастомная роль персоны (добавляется админом поверх системного каталога lib/roles.ts)
model CustomRole {
  id        String   @id @default(cuid())
  name      String
  /// стабильный код (slug) — хранится в Person.roles как "c:<id>"
  createdAt DateTime @default(now())
}

/// Медиатека: фото (персоны/клубы/команды/стадионы/баннеры) и файлы протоколов (PDF/фото).
/// Хранится в БД (bytea) — переживает пересоздание контейнера, уходит в бэкапы БД.
model Media {
  id        String   @id @default(cuid())
  mime      String
  filename  String?
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

// ============================================================
// Milestone 2: Tournament Engine
// ============================================================

model League {
  id        String  @id @default(cuid())
  name      String
  /// Короткое имя для сайдбара/виджетов
  shortName String?
  /// F11 | F8 | F6 | FUTSAL
  format    String
  /// Закреплена в «Топ-лигах» левого сайдбара (админ)
  isPinned  Boolean @default(false)
  /// Порядок в «Топ-лигах» (меньше — выше)
  priority  Int     @default(0)
  /// Epic 1: дисциплинарные правила
  yellowCardLimit      Int @default(3)
  yellowCardBanMatches Int @default(1)
  redCardBanMatches    Int @default(1)
  /// Epic 2: регламентный счёт техпоражения (3 — футбол, 5 — мини-футбол)
  walkoverScore        Int @default(3)
  /// Epic 3: трансферное окно
  transferWindowEnd    DateTime?
  seasons    Season[]
  /// v1.0.32: LEAGUE_ADMIN-аккаунты, привязанные к этой лиге (скоуп доступа)
  admins     User[]
  createdAt  DateTime @default(now())
}

model Season {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id])
  name      String
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean  @default(false)
  stages        Stage[]
  registrations Registration[]
  suspensions   Suspension[]

  @@index([leagueId])
}

model Stage {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id])
  name     String
  /// ROUND_ROBIN | KNOCKOUT | GROUP
  type     String
  /// JSON-конфиг порядка тай-брейков (PRD M2)
  tieBreakers String @default("points,head_to_head,goal_diff,goals_for,wins,fair_play,name")
  matches  Match[]

  @@index([seasonId])
}

model Match {
  id         String   @id @default(cuid())
  /// NULL для товарищеских матчей (вне чемпионатов — без сезонов/таблиц/статистики)
  stageId    String?
  stage      Stage?   @relation(fields: [stageId], references: [id])
  /// Товарищеский матч: не участвует в таблицах, бомбардирах и дисциплине
  isFriendly Boolean  @default(false)
  round      Int?
  homeTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  stadiumId  String?
  stadium    Stadium? @relation(fields: [stadiumId], references: [id])
  kickoff    DateTime
  /// SCHEDULED | LIVE | COMPLETED | WALKOVER | POSTPONED
  status     String   @default("SCHEDULED")
  /// Epic 2: HOME (неявка хозяев) | AWAY (неявка гостей) | BOTH (срыв)
  walkoverType String?
  /// Фактический счёт. Для WO остаётся NULL — подставляется регламентный (COALESCE-принцип PRD)
  homeScore  Int?
  awayScore  Int?
  /// Судья-арбитр. Инвариант: матч не завершается без главного судьи
  refereeId  String?
  referee    Person?  @relation("MatchReferee", fields: [refereeId], references: [id])
  note       String?
  /// Скан/файл бумажного протокола: /api/media/<id> (загружается в редакторе протокола)
  protocolUrl      String?
  protocolFileName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  events  MatchEvent[]
  lineups LineupEntry[]
  ratings RefereeRating[]
  officials MatchOfficial[]

  @@index([stageId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([refereeId])
  @@index([kickoff])
}

/// Официальные лица матча (судейский корпус + организаторы + врач).
/// Главный судья дублируется в Match.refereeId (инвариант завершения),
/// остальные роли бригады живут здесь: помощники (×2), резервный, VAR/AVAR,
/// инспектор, делегат, врач (×2).
model MatchOfficial {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  /// REFEREE | ASSISTANT_REFEREE | FOURTH_OFFICIAL | VAR | AVAR | INSPECTOR | DELEGATE | DOCTOR
  role      String
  createdAt DateTime @default(now())

  @@unique([matchId, personId, role])
  @@index([personId])
}

// ============================================================
// Milestone 3: Match Protocol & Analytics
// ============================================================

/// Событие протокола. Инвариант: person должен быть заявлен за team на дату матча и не дисквалифицирован
model MatchEvent {
  id             String  @id @default(cuid())
  matchId        String
  match          Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  minute         Int
  /// Добавленное время тайма: 45+3 → minute=45, stoppage=3 (NULL — обычная минута)
  stoppage       Int?
  /// GOAL | PENALTY | OWN_GOAL | YELLOW_CARD | RED_CARD | SUBSTITUTION | SUB_OUT | SUB_IN | VAR_*
  /// SUBSTITUTION: personId — вышедший, assistPersonId — ушедший (одна строка на замену).
  /// SUB_OUT/SUB_IN — легаси-пары старых протоколов, читаются, но не создаются.
  type           String
  personId       String
  person         Person  @relation("EventPerson", fields: [personId], references: [id])
  teamId         String
  team           Team    @relation(fields: [teamId], references: [id])
  assistPersonId String?
  assistPerson   Person? @relation("EventAssist", fields: [assistPersonId], references: [id])
  createdAt      DateTime @default(now())

  @@index([matchId])
  @@index([personId])
  @@index([teamId])
}

/// Epic 3: заявка игрока на сезон (Человек + Команда + Сезон + даты)
model Registration {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id])
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id])
  seasonId  String
  season    Season    @relation(fields: [seasonId], references: [id])
  startDate DateTime
  endDate   DateTime?
  number    Int?
  /// PLAYER | COACH — человек может быть игроком в одной лиге и тренером в другой
  role      String    @default("PLAYER")
  /// ACTIVE | ENDED
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// История заявок разрешена (v1.0.23): игрок может уйти и ВЕРНУТЬСЯ в
  /// команду в том же сезоне. Уникальность — только для АКТИВНЫХ заявок:
  /// partial unique index (WHERE "endDate" IS NULL) создаётся миграцией
  /// 1_stage2_data_model (DSL Prisma частичные индексы не выражает).
  /// Строчный @@unique([personId, teamId, seasonId]) убран именно поэтому.
  /// Индексы ниже — горячие выборки (составы, бомбардиры, заявки сезона).
  @@index([personId, seasonId])
  @@index([teamId, seasonId])
  @@index([seasonId])
}

/// Заявленный состав на конкретный матч
model LineupEntry {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])
  personId String
  person   Person @relation(fields: [personId], references: [id])
  isStarter Boolean @default(true)
  number   Int?
  createdAt DateTime @default(now())

  @@unique([matchId, personId])
  @@index([personId])
}

/// Epic 1: дисквалификация. Скоуп — сезон (турнир)
model Suspension {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id])
  seasonId  String
  season    Season   @relation(fields: [seasonId], references: [id])
  /// AUTO_RED | AUTO_YELLOW | MANUAL (КДК)
  source    String
  /// Причина: "Агрессия", "Оскорбление судьи", "Договорной матч"...
  reason    String?
  matchesTotal Int   @default(1)
  matchesServed Int  @default(0)
  isLifetime    Boolean @default(false)
  isActive      Boolean @default(true)
  /// Матч-источник (та самая красная, из-за которой бан)
  triggeredByMatchId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, seasonId])
  @@index([seasonId])
}

/// Оценка судьи капитанами/админами после матча (Milestone 5)
model RefereeRating {
  id           String  @id @default(cuid())
  matchId      String
  match        Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  refereeId    String
  referee      Person  @relation("RatingReferee", fields: [refereeId], references: [id])
  authorUserId String
  author       User    @relation("RatingAuthor", fields: [authorUserId], references: [id])
  /// 1..5
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  @@unique([matchId, authorUserId])
  @@index([refereeId])
}

/// Рекламные слоты (Milestone 4): управляются вручную через админку
model Banner {
  id        String   @id @default(cuid())
  /// TOP (полоса под шапкой) | BOTTOM (полоса над футером) |
  /// LEFT_TOP | LEFT_BOTTOM (колонка слева: под списком лиг) |
  /// RIGHT_TOP | RIGHT_BOTTOM (колонка справа: статистика/таблица) |
  /// BACKGROUND (фоновая заливка экрана, видна слева/справа от
  /// контентной колонки 800px — как на cybersport.ru)
  placement String
  title     String
  imageUrl  String?
  linkUrl   String?
  /// Текст слогана, если нет картинки
  text      String?
  isActive  Boolean  @default(true)
  priority  Int      @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  /// Масштабирование картинки: cover (заполнить) | contain (вписать) |
  /// repeat (замостить). Для BACKGROUND по умолчанию — cover.
  imageFit  String?
  /// Позиция картинки: center | top | bottom
  imagePos  String?
  /// Маркировка «Реклама»: размер шрифта, px (6–16; по умолчанию 9)
  markSize  Int?
  /// Маркировка «Реклама»: прозрачность, % (20–100; по умолчанию 70)
  markOpacity Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Виды футбола в меню сайта (v1.0.29): админ добавляет/убирает/переименовывает
/// форматы под ситуацию (11×11, футзал 5×5, ЛФЛ 8×8, разновидности…).
/// code должен совпадать с League.format — по нему фильтруется лента ?format=.
/// Сид миграции 00000000000002 заводит базовую четвёрку F11/F8/F6/FUTSAL.
model FormatLink {
  id        String   @id @default(cuid())
  /// Код формата: совпадает с League.format (F11, F8, F7…)
  code      String   @unique
  /// Подпись в меню: «Футбол», «8×8», «ЛФЛ 8×8»…
  label     String
  /// Порядок в меню (меньше — выше)
  sortOrder Int      @default(0)
  /// Показывать ссылку в меню сайта
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Стат-карточки (v1.0.29): редакционные блоки статистики в правой колонке —
/// «Бомбардир тура» с фото игрока, «Клуб недели» с лого и т.п.
/// АНТИ-CLS: карточка всегда рендерится боксом ФИКСИРОВАННОЙ высоты —
/// с картинкой и без неё размер одинаков, интерфейс не прыгает.
model StatBlock {
  id        String   @id @default(cuid())
  /// Заголовок: «Бомбардир тура», «Клуб недели»
  title     String
  /// Подпись/текст: «Иванов · «Заря» — лучший снайпер»
  text      String?
  /// Крупная цифра (опционально): «12» голов / «+7» серия
  value     String?
  /// Фото/картинка (Media): фото игрока, лого клуба
  imageUrl  String?
  /// Куда ведёт клик: /player/<id>, /team/<id> или внешний URL
  linkUrl   String?
  /// Масштаб картинки: cover | contain
  imageFit  String?
  /// Позиция картинки: center | top | bottom
  imagePos  String?
  isActive  Boolean  @default(true)
  /// Порядок в колонке (меньше — выше)
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Инвариант №4: журнал аудита всех пост-фактум изменений
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  entity    String
  entityId  String
  /// CREATE | UPDATE | DELETE | MERGE | COMPLETE | WO_ASSIGN | RESET
  action    String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}
